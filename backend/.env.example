DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
DB_ENGINE=sqlite
# Preferred managed-production setting (PostgreSQL, MySQL, or SQLite URL):
# DATABASE_URL=postgresql://embro:replace-me@db:5432/embro
# Or use DB_ENGINE=postgres with the DB_* variables below.
# Turso/libSQL:
# DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=replace-with-a-database-token
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=embro_store
# DB_USER=embro_store
# DB_PASSWORD=replace-me
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=support@example.com

# Production object storage (AWS S3 or an S3-compatible provider)
USE_S3=False
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_STORAGE_BUCKET_NAME=embro-media
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=media.example.com
