DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=

# Persistent Turso database (recommended for Vercel)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token

# Optional MySQL alternative. Set DB_ENGINE=mysql to enable it.
DB_ENGINE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=embro_store
DB_USER=embro_store
DB_PASSWORD=replace-me
