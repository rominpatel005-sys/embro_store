DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://embrostore.vercel.app

# ─── PostgreSQL Database ───────────────────────────────────────────────────────
# Option A: Single connection URL (recommended for Neon, Supabase, Railway, etc.)
#   Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:your_password@localhost:5432/embro_store

# Option B: Individual vars (used when DATABASE_URL is not set)
DB_NAME=embro_store
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
